# Supabase > Project Settings > API (브라우저에 노출돼도 되는 값)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 공공데이터포털(data.go.kr) 인증키 - 서버 전용 (Encoding/Decoding 키 모두 가능)
ODCLOUD_SERVICE_KEY=your-data-go-kr-key

# Pixabay API 키 (서버 전용 - VITE_ 접두사를 붙이지 말 것)
PIXABAY_API_KEY=your-pixabay-key
